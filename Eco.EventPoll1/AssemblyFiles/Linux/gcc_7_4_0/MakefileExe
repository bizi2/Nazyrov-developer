# C++ compiler flags (-g -O2 -Wall)
CCFLAGS = $(CCFLAGS_TARGET) -DLINUX -DUGUID_UTILITY -DECO_LINUX -DECO_X86_64

# compiler
GNU =
CC = gcc
AR = gcc-ar

ifeq ($(TARGET), 1)
LIBS_TARGET=-l777B4B258FDC44C9A54F78A98339851F
else
LIBS_TARGET=
endif

# library paths
LIBS = $(LIB_DIR) -lm -lc -lgcc -ldl -l00000000000000000000000053595333 -l0000000000000000000000004D656D31 -l00000000000000000000000042757331 -l84CC0A7DBABD44EEBE749C9A8312D37E -l53884AFC93C448ECAA929C8D3A562281 -l97322B6765B74342BBCE38798A0B40B5 -l00000000000000000000000046534D31 -lB7D8E10E1D3540CCB1CA96F766AF1936 -l5B2BA17BEA704527BC708F88568FE115 $(LIBS_TARGET)

# compile flags
LDFLAGS = $(LDFLAGS_TARGET) $(LIBS)

.SUFFIXES: .c

.c.o:
	$(CC) $(INCLUDES) $(CCFLAGS) -c $< -o $@

$(OUT): $(OBJ)
	mkdir -p $(OUT_DIR)
	$(CC) ${LDFLAGS} -o $(OUT_DIR)/$(OUT) $(OBJ) $(LDFLAGS)
	rm $(OBJ)

clean:
	rm $(OBJ) $(OUT_DIR)/$(OUT)

